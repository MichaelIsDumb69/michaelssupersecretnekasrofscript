local player = game.Players.LocalPlayer

local default_ANIM_IDS = {
	idle = "rbxassetid://74530436512522",
	walk = "rbxassetid://94721495253171",
	run = "rbxassetid://109671225388655",
	m1 = "rbxassetid://123569615350667",
	block = "rbxassetid://85591573377728",
	blocked = "rbxassetid://80277760801310"
}

local levitate_ANIM_IDS = {
	idle = "rbxassetid://107756518054855",
	walk = "rbxassetid://102812745115149",
	run = "rbxassetid://125869734469543",
	m1 = default_ANIM_IDS.m1,
	block = default_ANIM_IDS.block,
	blocked = default_ANIM_IDS.blocked
}

local ANIM_IDS = getgenv().AnimationVar == "L" and levitate_ANIM_IDS or default_ANIM_IDS

local OVERRIDES = {
	["rbxassetid://72722244508749"] = ANIM_IDS.block,
	["rbxassetid://87259391926321"] = ANIM_IDS.m1,
	["rbxassetid://106014898528300"] = ANIM_IDS.m1,
	["rbxassetid://86545133269813"] = ANIM_IDS.m1,
	["rbxassetid://89448354637442"] = ANIM_IDS.m1,
	["rbxassetid://131257799030455"] = ANIM_IDS.m1,
	["rbxassetid://180426354"] = ANIM_IDS.idle,
	["rbxassetid://180435571"] = ANIM_IDS.walk,
	["rbxassetid://119434518007321"] = false,
	["rbxassetid://115194624791339"] = false
}

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Sprinting = ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting")
local m = require(Sprinting)
m.MaxStamina = 200
m.StaminaGain = 75
m.StaminaLoss = 20
m.SprintSpeed = 24

local function createAnimation(id)
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	return anim
end

local activeTracks = {}

local function stopAllTracks(smooth)
	for _, track in pairs(activeTracks) do
		if track and track.IsPlaying then
			if smooth then
				track:AdjustWeight(0, 0.15)
				track:Stop(0.15)
			else
				track:Stop()
			end
		end
	end
	table.clear(activeTracks)
end

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator")

	local anims = {
		idle = humanoid:LoadAnimation(createAnimation(ANIM_IDS.idle)),
		walk = humanoid:LoadAnimation(createAnimation(ANIM_IDS.walk)),
		run = humanoid:LoadAnimation(createAnimation(ANIM_IDS.run)),
		m1 = humanoid:LoadAnimation(createAnimation(ANIM_IDS.m1))
	}

	anims.idle.Priority = Enum.AnimationPriority.Idle
	anims.walk.Priority = Enum.AnimationPriority.Movement
	anims.run.Priority = Enum.AnimationPriority.Action
	anims.m1.Priority = Enum.AnimationPriority.Action2

	local canAttack = true
	local cooldown = 2
	local isMoving, isRunning

	function onM1Click()
		if canAttack then
			canAttack = false
			stopAllTracks(true)
			anims.m1:Play()
			activeTracks["m1"] = anims.m1
			task.wait(cooldown)
			canAttack = true
		end
	end

	animator.AnimationPlayed:Connect(function(track)
		local originalId = track.Animation.AnimationId
		if originalId == ANIM_IDS.blocked or OVERRIDES[originalId] == false then
			track:Stop()
		elseif OVERRIDES[originalId] then
			track:Stop()
			stopAllTracks(true)
			local replacementAnim = Instance.new("Animation")
			replacementAnim.AnimationId = OVERRIDES[originalId]
			local newTrack = animator:LoadAnimation(replacementAnim)
			newTrack:Play()
			activeTracks["override"] = newTrack
			if OVERRIDES[originalId] == ANIM_IDS.m1 then
				onM1Click()
			end
		end
	end)

	RunService.Heartbeat:Connect(function()
		isMoving = humanoid.MoveDirection.Magnitude > 0
		isRunning = humanoid.WalkSpeed > 16

		local overridePlaying = false
		for name, track in pairs(activeTracks) do
			if name ~= "idle" and name ~= "walk" and name ~= "run" and track.IsPlaying then
				overridePlaying = true
				break
			end
		end

		if not overridePlaying then
			if isMoving then
				if isRunning then
					if activeTracks["run"] ~= anims.run then
						stopAllTracks(true)
						anims.run:Play()
						activeTracks["run"] = anims.run
					end
				else
					if activeTracks["walk"] ~= anims.walk then
						stopAllTracks(true)
						anims.walk:Play()
						activeTracks["walk"] = anims.walk
					end
				end
			else
				if activeTracks["idle"] ~= anims.idle then
					stopAllTracks(true)
					anims.idle:Play()
					activeTracks["idle"] = anims.idle
				end
			end
		end
	end)

	humanoid.WalkSpeed = 16
end

if player.Character then
	setupCharacter(player.Character)
end
